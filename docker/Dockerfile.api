FROM python:3.14-slim AS base
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libmagic1 curl tini && rm -rf /var/lib/apt/lists/*

FROM base AS deps
COPY pyproject.toml .
RUN pip install --no-cache-dir --upgrade pip "setuptools>=83.0.0" "msgpack>=1.2.1" && pip install --no-cache-dir .


FROM deps AS app
RUN groupadd -g 10001 appgroup && useradd -u 10001 -g appgroup -d /app -s /sbin/nologin appuser
COPY . .
COPY docker/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh && mkdir -p /app/keys && chown -R 10001:10001 /app

USER 10001
EXPOSE 8000
ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
