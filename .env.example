# ===== Application =====
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=true
UVICORN_WORKERS=4

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://<REPLACE_ME>:<REPLACE_ME>@localhost:5432/procurement
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600
SQL_ECHO=false

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_DB=0
REDIS_RATE_LIMIT_DB=1
REDIS_CACHE_DB=2
REDIS_CELERY_BACKEND_DB=3

# ===== RabbitMQ =====
RABBITMQ_URL=amqp://<REPLACE_ME>:<REPLACE_ME>@localhost:5672/procurement

# ===== MinIO =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=<REPLACE_ME>
MINIO_SECRET_KEY=<REPLACE_ME>
MINIO_USE_SSL=false
MINIO_MAX_FILE_SIZE_MB=50

# ===== JWT / Auth =====
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_HOURS=8
JWT_KEY_ID=key-2026-06
JWT_ALGORITHM=RS256
MFA_INACTIVITY_TIMEOUT_MINUTES=30
MAX_CONCURRENT_SESSIONS=5
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30

# ===== Field Encryption =====
FIELD_ENCRYPTION_KEY=<REPLACE_ME>

# ===== ClamAV Antivirus Scanner =====
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10

# ===== Enterprise SSO (SAML 2.0 & OIDC) =====
SAML_ENABLED=false
SAML_IDP_METADATA_URL=
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_CERTIFICATE=
SAML_SP_ENTITY_ID=https://procurement.portal/api/v1/auth/sso/saml
SAML_SP_ACS_URL=http://localhost:8000/api/v1/auth/sso/callback

OIDC_ENABLED=false
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/oidc/callback

# ===== External Services =====
GST_API_BASE_URL=
GST_API_KEY=
NSDL_API_BASE_URL=
NSDL_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_INTEGRATION_KEY=

# ===== Observability =====
JAEGER_HOST=localhost
JAEGER_PORT=4317
OTEL_SAMPLING_RATE=1.0
LOG_LEVEL=INFO

# ===== CORS =====
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002"]

# ===== Celery =====
CELERY_BROKER_URL=amqp://<REPLACE_ME>:<REPLACE_ME>@localhost:5672/procurement
CELERY_RESULT_BACKEND=redis://localhost:6379/3
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=true
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600
CELERY_BEAT_SCHEDULER=celery.beat:PersistentScheduler
CELERY_BEAT_SCHEDULE_FILENAME=celerybeat-schedule
CELERY_BROKER_POOL_LIMIT=10

# ===== Business Rules =====
PR_APPROVAL_THRESHOLD=50000
PO_APPROVAL_THRESHOLD=100000
BID_MINIMUM_VENDORS=3
BID_SUBMISSION_DEADLINE_DAYS=7
CONTRACT_RENEWAL_NOTICE_DAYS=30
INVOICE_PAYMENT_TERMS_DAYS=30
VENDOR_ONBOARDING_APPROVAL_REQUIRED=true
MAX_FILE_UPLOAD_SIZE_MB=50
ENABLE_BUDGET_CHECK=true
BUDGET_TOLERANCE_PERCENTAGE=5
ENABLE_AUTO_PO_GENERATION=false
AUTO_PO_THRESHOLD=10000

# ===== Superadmin Seed =====
SUPERADMIN_EMAIL=<REPLACE_ME>
SUPERADMIN_PASSWORD=<REPLACE_ME>
SUPERADMIN_ORG_NAME=<REPLACE_ME>
SUPERADMIN_ORG_CODE=<REPLACE_ME>
