# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force LF on shell scripts, configuration, Dockerfiles, and code files
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.ini text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.toml text eol=lf
*.env* text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
Dockerfile* text eol=lf
docker/* text eol=lf
kong/* text eol=lf
